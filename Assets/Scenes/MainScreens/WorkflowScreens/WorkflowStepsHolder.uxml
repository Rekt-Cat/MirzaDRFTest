<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="WorkflowStepUI" src="WorkflowStepUI.uxml" />
    <ui:VisualElement name="workflow-root" style="flex-grow: 1; flex-direction: column; background-color: rgb(240, 243, 250);">
        <ui:VisualElement name="step-container" style="flex-grow: 1; flex-direction: column;">
            <ui:Instance template="WorkflowStepUI" name="step-view" style="flex-grow: 1;" />
        </ui:VisualElement>
        <ui:VisualElement name="nav-bar" style="flex-direction: row; justify-content: space-between; align-items: center; padding-top: 20px; padding-bottom: 20px; padding-left: 28px; padding-right: 28px; background-color: rgb(255, 255, 255); border-top-width: 1px; border-top-color: rgb(220, 224, 235);">
            <ui:Button name="btn-prev" text="← Previous" style="background-color: rgb(255, 255, 255); color: rgb(66, 135, 245); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(66, 135, 245); border-right-color: rgb(66, 135, 245); border-bottom-color: rgb(66, 135, 245); border-left-color: rgb(66, 135, 245); padding-top: 12px; padding-bottom: 12px; padding-left: 28px; padding-right: 28px; font-size: 14px; -unity-font-style: bold;" />
            <ui:Button name="btn-next" text="Next →" style="background-color: rgb(66, 135, 245); color: rgb(255, 255, 255); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 12px; padding-bottom: 12px; padding-left: 28px; padding-right: 28px; font-size: 14px; -unity-font-style: bold;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
